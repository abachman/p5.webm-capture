{
  "name": "p5.webm-capture",
  "version": "1.3.0",
  "description": "A frame-by-frame video capture, encode, and export utility for p5.js",
  "browser": "dist/p5.webm-capture.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "preversion": "",
    "version": "npm run build && git add -A dist",
    "postversion": "git push && git push --tags && rm -rf build/temp",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abachman/p5.webm-capture.git"
  },
  "keywords": [
    "p5.js",
    "p5js",
    "p5",
    "processing.org"
  ],
  "author": "Adam Bachman <adam.bachman@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abachman/p5.webm-capture/issues"
  },
  "homepage": "https://github.com/abachman/p5.webm-capture#readme",
  "dependencies": {
    "ccapture.js": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/tar": "^6.1.13",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tar": "^7.5.22",
    "typescript": "^5.7.0"
  }
}
