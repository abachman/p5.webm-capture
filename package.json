{
  "name": "p5.webm-capture",
  "version": "1.3.0",
  "description": "A frame-by-frame capture and webm video export utility for p5.js",
  "browser": "dist/p5.webm-capture.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "preversion": "",
    "version": "npm run build && git add -A dist",
    "postversion": "git push && git push --tags && rm -rf build/temp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abachman/p5.webm-capture.git"
  },
  "keywords": [
    "p5.js",
    "p5js",
    "p5",
    "processing.org"
  ],
  "author": "Adam Bachman <adam.bachman@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abachman/p5.webm-capture/issues"
  },
  "homepage": "https://github.com/abachman/p5.webm-capture#readme",
  "dependencies": {
    "ccapture.js": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
